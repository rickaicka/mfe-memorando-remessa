{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "daruix-mfe-remessas": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": {
              "target": "daruix-mfe-remessas:esbuild:production"
            },
            "development": {
              "target": "daruix-mfe-remessas:esbuild:development",
              "dev": true
            },
            "emulator": {
              "target": "daruix-mfe-remessas:esbuild:emulator",
              "dev": true
            },
            "device": {
              "target": "daruix-mfe-remessas:esbuild:device",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "development": {
              "target": "daruix-mfe-remessas:serve-original:development",
              "dev": true,
              "port": 4301
            },
            "emulator": {
              "target": "daruix-mfe-remessas:serve-original:emulator",
              "dev": true,
              "port": 4301
            },
            "device": {
              "target": "daruix-mfe-remessas:serve-original:device",
              "dev": true,
              "port": 4301
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/daruix-mfe-remessas",
              "browser": ""
            },
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "polyfills": [
              "es-module-shims"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "emulator": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.emulator.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "device": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.device.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "0.0.0.0",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "daruix-mfe-remessas:esbuild:production"
            },
            "development": {
              "buildTarget": "daruix-mfe-remessas:esbuild:development"
            },
            "emulator": {
              "buildTarget": "daruix-mfe-remessas:esbuild:emulator"
            },
            "device": {
              "buildTarget": "daruix-mfe-remessas:esbuild:device"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
